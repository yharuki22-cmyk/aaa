# ============================================================
# 生成AI設定（任意）
# ------------------------------------------------------------
# APIキーを設定しない場合でも、アプリは「ローカル簡易生成モード」で
# 問題を作成できます（オフライン動作）。
# より高品質な問題・解説が必要な場合のみ、以下を設定してください。
#
# このファイルをコピーして `.env` を作成し、値を書き換えてください。
#   Windows(PowerShell):  Copy-Item .env.example .env
#   Windows(cmd):         copy .env.example .env
#
# .env は .gitignore によりGitの管理対象から除外されています。
# APIキーをソースコードやリポジトリに直接書かないでください。
# ============================================================

# 生成AIを使うか（true でAIモードを有効化。未設定/false ならローカル生成のみ）
AI_ENABLED=false

# OpenAI互換のChat Completions APIキー（例: OpenAI, OpenRouter, Azure, ローカルLLM 等）
# 特定サービスに依存しないよう、OpenAI互換エンドポイントを想定しています。
AI_API_KEY=

# APIのベースURL（OpenAI互換。末尾の /chat/completions は不要）
# 例) OpenAI:      https://api.openai.com/v1
# 例) OpenRouter:  https://openrouter.ai/api/v1
# 例) ローカル:    http://localhost:11434/v1   （Ollama など）
AI_BASE_URL=https://api.openai.com/v1

# 使用モデル名
AI_MODEL=gpt-4o-mini
